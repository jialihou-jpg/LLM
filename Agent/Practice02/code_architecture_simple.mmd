```mermaid
flowchart TD
    %% 主标题
    TITLE["Chat Tool File Operations 架构"]:::titleStyle
    
    %% 用户交互层
    subgraph UI["用户交互层"]
        USER["👤 用户"]:::user
        INPUT["📝 用户输入处理"]:::process
    end
    
    %% 应用控制层
    subgraph APP["应用控制层"]
        MAIN["🔄 主循环控制器"]:::controller
        HISTORY["📚 对话历史管理器"]:::data
        CONFIG["⚙️ 配置管理器"]:::config
    end
    
    %% LLM交互层
    subgraph LLM["LLM交互层"]
        API["🔗 LLM API接口"]:::api
        STREAM["🌊 流式响应处理器"]:::process
        TCALLS["🛠️ 工具调用解析器"]:::process
    end
    
    %% 工具管理层
    subgraph TOOLS["工具管理层"]
        TREG["📋 工具注册表"]:::data
        TDISP["🚦 工具分发器"]:::process
        TPARS["🔤 JSON参数解析器"]:::process
    end
    
    %% 文件操作层
    subgraph FILES["文件操作层"]
        DIR["📁 目录操作"]:::filetool
        INFO["📄 文件信息获取"]:::filetool
        CRUD["✏️ 文件CRUD操作"]:::filetool
    end
    
    %% 系统依赖层
    subgraph SYS["系统依赖层"]
        REQ["requests库"]:::lib
        OS["os模块"]:::lib
        JSON["json模块"]:::lib
        CFG["configparser"]:::lib
    end
    
    %% 样式定义
    classDef titleStyle fill:#ff9900,stroke:#e68a00,color:white,stroke-width:3px
    classDef user fill:#66ccff,stroke:#3399ff,stroke-width:2px
    classDef controller fill:#ffcc66,stroke:#ff9900,stroke-width:1.5px
    classDef process fill:#c9e2ff,stroke:#6aa3d5,stroke-width:1.5px
    classDef data fill:#d4fcce,stroke:#6bde55,stroke-width:1.5px
    classDef config fill:#ffd9b3,stroke:#ff9933,stroke-width:1.5px
    classDef api fill:#c6f4ff,stroke:#33ccff,stroke-width:1.5px
    classDef filetool fill:#e6ccff,stroke:#b366ff,stroke-width:1.5px
    classDef lib fill:#f0f0f0,stroke:#999,stroke-width:1px
    
    %% 主要数据流
    USER --> INPUT
    INPUT --> MAIN
    MAIN --> HISTORY
    HISTORY --> API
    
    CONFIG --> API[读取API配置]
    CONFIG --> MAIN[应用配置]
    CONFIG --> CFG
    
    API --> STREAM[流式响应]
    STREAM --> TCALLS[解析工具调用]
    TCALLS --> TREG[检查工具注册]
    TCALLS --> REQ[使用requests]
    
    TREG --> TDISP[分发工具调用]
    TDISP --> TPARS[解析参数]
    TPARS --> JSON[使用json]
    TPARS --> DIR[调用目录工具]
    TPARS --> INFO[调用文件信息]
    TPARS --> CRUD[调用CRUD工具]
    
    DIR --> OS[系统操作]
    INFO --> OS
    CRUD --> OS
    
    %% 执行结果返回流
    DIR --> TDISP
    INFO --> TDISP
    CRUD --> TDISP
    
    TDISP --> TCALLS[返回执行结果]
    TCALLS --> STREAM[格式化响应]
    STREAM --> API[发送回复]
    API --> HISTORY[记录到历史]
    HISTORY --> MAIN[更新状态]
    MAIN --> INPUT[等待新输入]
    
    %% 工具注册详情
    TOOLS_REG["📋 已注册工具：<br/>- getcwd<br/>- listDir<br/>- getFileType<br/>- readFile<br/>- createFile<br/>- editFile"]:::noteStyle
    TREG -.-> TOOLS_REG
    
    %% 主要功能流程
    PROCESS["🔄 主流程：<br/>1. 用户输入 -> 系统处理<br/>2. LLM分析 -> 工具调用识别<br/>3. 工具执行 -> 结果返回<br/>4. LLM整合 -> 回复用户"]:::processNote
    MAIN -.-> PROCESS
    
    classDef noteStyle fill:#ffffcc,stroke:#cccc00,stroke-width:1px
    classDef processNote fill:#ccffff,stroke:#00cccc,stroke-width:1px
    
    %% 架构层次说明
    LAYER_TEXT["🏗️ 架构层次：<br/>- 用户交互层<br/>- 应用控制层<br/>- LLM交互层<br/>- 工具管理层<br/>- 文件操作层<br/>- 系统依赖层"]:::layerStyle
    TITLE --> LAYER_TEXT
    
    classDef layerStyle fill:#f5f5f5,stroke:#666,stroke-width:1.5px
```